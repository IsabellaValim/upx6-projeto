# Copie para .env e ajuste se precisar:  cp .env.example .env
# O .env NAO e comitado (ver .gitignore). O Compose le este arquivo
# automaticamente quando roda na raiz do projeto.

# Porta publicada no host para o Postgres do docker-compose.
# Padrao 5432. Use outra (ex. 5433) se a 5432 ja estiver ocupada na sua
# maquina por um Postgres instalado nativamente.
# Atencao: no Windows/WSL, ss e netstat dentro do WSL nao mostram listeners
# do lado Windows, entao o conflito so aparece ao subir o container.
DB_PORT=5432
